{
  "ignoreCommand": "git diff --name-only HEAD^ HEAD | grep -v '^.hermes/plans/' | grep -q . && exit 1 || exit 0",
  "headers": [
    {
      "source": "/changelog.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
